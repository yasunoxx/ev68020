PLDCLK_INV_WRLL_delay: DELAY PLDCLK INV_WRLL;
PLDCLK_INV_WRUM_delay: DELAY PLDCLK INV_WRUM;
PLDCLK_INV_MPU_DSACK1_delay: DELAY PLDCLK INV_MPU_DSACK1;
PLDCLK_INV_MPU_DSACK0_delay: DELAY PLDCLK INV_MPU_DSACK0;
PLDCLK_INV_WRL_delay: DELAY PLDCLK INV_WRL;
PLDCLK_INV_WRU_delay: DELAY PLDCLK INV_WRU;
PLDCLK_INV_WRLL_delay: DELAY PLDCLK INV_WRLL;
PLDCLK_INV_WRLM_delay: DELAY PLDCLK INV_WRLM;
PLDCLK_INV_WRUM_delay: DELAY PLDCLK INV_WRUM;
PLDCLK_INV_WRUU_delay: DELAY PLDCLK INV_WRUU;
PLDCLK_INV_RD_delay: DELAY PLDCLK INV_RD;
PLDCLK_INV_WR_delay: DELAY PLDCLK INV_WR;

/* timing check arc definitions */
A0_PLDCLK_setup: SETUP(POSEDGE) A0 PLDCLK;
A0_PLDCLK_hold: HOLD(POSEDGE) A0 PLDCLK;
A1_PLDCLK_setup: SETUP(POSEDGE) A1 PLDCLK;
