MODEL
MODEL_VERSION "1.0";
DESIGN "ev68020_arbiter";
DATE "Sat Nov 16 04:16:54 2024";
VENDOR "Lattice Semiconductor Corporation";
PROGRAM "STAMP Model Generator";

/* port name and type */
INPUT INV_SEL_C;
INPUT INV_SEL_1;
INPUT INV_SEL_0;
INPUT SIZ1;
INPUT WAIT2;
INPUT SIZ0;
INPUT WAIT1;
INPUT INV_AS;
INPUT INV_DS;
INPUT INV_FC2;
INPUT A1;
INPUT INV_FC1;
INPUT A0;
INPUT INV_FC0;
INPUT INV_SEL_4TOB;
INPUT R_W;
INPUT XRESET;
INPUT PLDCLK;
INPUT INV_SEL_F;
OUTPUT INV_MPU_DSACK1;
OUTPUT INV_CPU;
OUTPUT INV_WRUM;
OUTPUT INV_WRLL;
OUTPUT INV_WRL;
OUTPUT INV_WR;
OUTPUT INV_WRLM;
OUTPUT INV_IACK_AVEC;
OUTPUT INV_WRUU;
OUTPUT INV_WRU;
OUTPUT INV_RD;
OUTPUT INV_MPU_DSACK0;

/* timing arc definitions */
PLDCLK_INV_IACK_AVEC_delay: DELAY PLDCLK INV_IACK_AVEC;
PLDCLK_INV_CPU_delay: DELAY PLDCLK INV_CPU;
PLDCLK_INV_RD_delay: DELAY PLDCLK INV_RD;
PLDCLK_INV_WRU_delay: DELAY PLDCLK INV_WRU;
