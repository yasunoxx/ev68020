if {![file exists "C:/Users/Yasuno/Documents/dev/ev68020/pld/LCMXO2-256/arbitor_top_sim1/arbitor_top_sim1.mpf"]} { 
	project new "C:/Users/Yasuno/Documents/dev/ev68020/pld/LCMXO2-256/arbitor_top_sim1" arbitor_top_sim1
	project addfile "C:/Users/Yasuno/Documents/dev/ev68020/pld/LCMXO2-256/arbitor_top_sim1/arbiter_top.vhd"
	vlib  work
	vdel -lib work -all 
	vlib work
	vcom -work work "C:/Users/Yasuno/Documents/dev/ev68020/pld/LCMXO2-256/arbitor_top_sim1/arbiter_top.vhd"
} else {
	project open "C:/Users/Yasuno/Documents/dev/ev68020/pld/LCMXO2-256/arbitor_top_sim1/arbitor_top_sim1"
