VOLTAGE 3.350 V;
BANK 0 VCCIO 3.3 V;
BANK 1 VCCIO 2.5 V;
BANK 2 VCCIO 3.3 V;
BANK 3 VCCIO 3.3 V;
BLOCK ASYNCPATHS ;
IOBUF PORT "INV_RD" IO_TYPE=LVCMOS25 ;
IOBUF PORT "PLDCLK" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_CPU" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_IACK_AVEC" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_MPU_DSACK0" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_MPU_DSACK1" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WRUU" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WRUM" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WRLM" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WRLL" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WRU" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WRL" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_WR" IO_TYPE=LVCMOS25 ;
IOBUF PORT "SIZ1" IO_TYPE=LVCMOS25 ;
IOBUF PORT "SIZ0" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_SEL_0" IO_TYPE=LVCMOS25 ;
IOBUF PORT "WAIT2" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_SEL_4toB" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_FC0" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_FC2" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_FC1" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_SEL_F" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_SEL_C" IO_TYPE=LVCMOS25 ;
IOBUF PORT "WAIT1" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_SEL_1" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_AS" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A1" IO_TYPE=LVCMOS25 ;
IOBUF PORT "A0" IO_TYPE=LVCMOS25 ;
IOBUF PORT "INV_DS" IO_TYPE=LVCMOS25 ;
IOBUF PORT "R_W" IO_TYPE=LVCMOS25 ;
FREQUENCY PORT "PLDCLK" 66.666000 MHz ;
VCCIO_DERATE PERCENT 0; 
